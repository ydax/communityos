# Firebase Client (Public - Exposed to Browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Private - Server-side Only)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Google AI (Gemini 2.0 Flash — AI Website Builder)
# Get your key at: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your_google_ai_studio_key_here

# Environment
NODE_ENV=development

# Optional: Vercel Configuration (Only needed if not using Vercel CLI)
# VERCEL_URL=your-preview-url.vercel.app

# Growth Pipelines
# Google Places API — used by the Digital Rescue pipeline (Pipeline 3)
# Get your key at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Kill switch: set to 'false' to halt the pipeline without a redeploy
ENABLE_DIGITAL_RESCUE_PIPELINE=true

# Checkout / Auth — Email-First Progressive Identity
# Secret used for HMAC-based OTP generation (generate a random 32+ char string)
OTP_SECRET=your_otp_secret_here

# Email delivery for OTP codes (optional — logs to console when unset)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

