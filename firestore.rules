rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    match /sites/{siteId} {
      allow read: if true; // Public sites are readable by anyone
      allow write: if isOwner() || (request.auth != null && !("ownerId" in resource.data) && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /listings/{listingId} {
      allow read: if true; // Public listings are readable by anyone
      allow write: if isOwner() || (request.auth != null && !("ownerId" in resource.data) && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /variants/{variantId} {
      allow read: if true; // Public variants are readable
      allow write: if isOwner() || (request.auth != null && !("ownerId" in resource.data) && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /inventory/{inventoryId} {
      allow read: if true; 
      // Inventory updates should typically be via server actions or strictly controlled
      allow write: if request.auth != null; 
    }
    
    match /orders/{orderId} {
      // Orders are private
      allow read: if isOwner();
      allow write: if request.auth != null && (isOwner() || request.auth.uid == request.resource.data.ownerId);
    }

    match /analytics/{siteId} {
      allow read: if isOwner();
      allow write: if false; // Only Cloud Functions write here
    }

    // ─── New collections for Progressive Shadow Identity + Cart ────

    match /users/{userId} {
      // Users can only read and update their own profile
      allow read: if request.auth != null && request.auth.uid == resource.data.firebaseUid;
      allow update: if request.auth != null && request.auth.uid == resource.data.firebaseUid;
      // Creation is server-side only (shadow user creation via admin SDK)
      allow create: if false;
      allow delete: if false;
    }

    match /users/{userId}/cart/{cartItemId} {
      // Cart items — authenticated user can CRUD their own cart
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid;
    }

    match /otpCodes/{email} {
      // OTP codes are server-side only (admin SDK reads/writes)
      allow read, write: if false;
    }
  }
}
